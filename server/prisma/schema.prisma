generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["social_gaming"]
}
model User {
 id String @id @default(cuid())
 username String @unique
 displayName String
 email String? @unique
 passwordHash String
 bio String @default("")
 avatarUrl String?
 coverUrl String?
 followersVisibility String @default("PUBLIC")
 followingVisibility String @default("PUBLIC")
 points Int @default(100)
 role String @default("USER")
 status String @default("ACTIVE")
 shieldUntil DateTime?
 createdAt DateTime @default(now())
 posts Post[]
 referralsSent Referral[] @relation("ReferralReferrer")
 referralReceived Referral? @relation("ReferralReferred")
 referralShareClaims ReferralShareClaim[]
 mysteryRewardClaims MysteryRewardClaim[]
 missionProgress MissionProgress[]
 battlesCreated Battle[] @relation("BattleCreator")
 battlesAsChallenger Battle[] @relation("BattleChallenger")
 battlesAsOpponent Battle[] @relation("BattleOpponent")
 battlesWon Battle[] @relation("BattleWinner")
 battleVotes BattleVote[]
 gameSessions GameSession[]
 achievements UserAchievement[]
 createdTeams Team[] @relation("TeamCreator")
 teamMemberships TeamMember[]
 adminActions AdminAction[] @relation("AdminActor")
 sentTransactions PointTransaction[] @relation("Sender")
 receivedTransactions PointTransaction[] @relation("Receiver")
 sentMessages Message[]
 notifications Notification[]
 followsOut Follow[] @relation("Following")
 followsIn Follow[] @relation("Followers")
 comments Comment[]
 likes Like[]
 @@schema("social_gaming")
}
model Post {
 id String @id @default(cuid())
 authorId String
 imageUrl String?
 caption String @default("")
 privacy String @default("PUBLIC")
 points Int @default(0)
 hidden Boolean @default(false)
 lastEditedAt DateTime?
 createdAt DateTime @default(now())
 author User @relation(fields:[authorId], references:[id], onDelete:Cascade)
 comments Comment[]
 likes Like[]
 @@index([createdAt])
 @@index([points])
 battlesAsChallengerPost Battle[] @relation("BattleChallengerPost")
 battlesAsOpponentPost Battle[] @relation("BattleOpponentPost")
 @@schema("social_gaming")
}
model Comment {
 id String @id @default(cuid())
 postId String
 authorId String
 body String
 createdAt DateTime @default(now())
 post Post @relation(fields:[postId], references:[id], onDelete:Cascade)
 author User @relation(fields:[authorId], references:[id], onDelete:Cascade)
 @@schema("social_gaming")
}
model Like {
 id String @id @default(cuid())
 postId String
 userId String
 createdAt DateTime @default(now())
 post Post @relation(fields:[postId], references:[id], onDelete:Cascade)
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@unique([postId,userId])
 @@schema("social_gaming")
}
model Follow {
 id String @id @default(cuid())
 followerId String
 followingId String
 createdAt DateTime @default(now())
 follower User @relation("Following", fields:[followerId], references:[id], onDelete:Cascade)
 following User @relation("Followers", fields:[followingId], references:[id], onDelete:Cascade)
 @@unique([followerId,followingId])
 @@schema("social_gaming")
}
model PointTransaction {
 id String @id @default(cuid())
 senderId String?
 receiverId String?
 amount Int
 type String
 note String @default("")
 createdAt DateTime @default(now())
 sender User? @relation("Sender", fields:[senderId], references:[id], onDelete:SetNull)
 receiver User? @relation("Receiver", fields:[receiverId], references:[id], onDelete:SetNull)
 @@index([createdAt])
 @@index([type])
 @@schema("social_gaming")
}
model StealCooldown {
 id String @id @default(cuid())
 thiefId String
 targetId String
 lastAt DateTime @default(now())
 @@unique([thiefId,targetId])
 @@schema("social_gaming")
}
model Message {
 id String @id @default(cuid())
 senderId String
 receiverId String
 body String
 readAt DateTime?
 createdAt DateTime @default(now())
 sender User @relation(fields:[senderId], references:[id], onDelete:Cascade)
 @@index([senderId,receiverId,createdAt])
 @@schema("social_gaming")
}
model Notification {
 id String @id @default(cuid())
 userId String
 text String
 readAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@schema("social_gaming")
}
model Report {
 id String @id @default(cuid())
 reporterId String
 targetType String
 targetId String
 category String
 details String @default("")
 status String @default("OPEN")
 createdAt DateTime @default(now())
 @@schema("social_gaming")
}
model Mission {
 id String @id @default(cuid())
 title String
 description String
 reward Int @default(0)
 active Boolean @default(true)
 @@schema("social_gaming")
}
model Battle {
 id String @id @default(cuid())
 title String
 status String @default("OPEN")
 creatorId String?
 challengerId String?
 opponentId String?
 challengerPostId String?
 opponentPostId String?
 winnerId String?
 challengerVotes Int @default(0)
 opponentVotes Int @default(0)
 reward Int @default(100)
 endsAt DateTime?
 createdAt DateTime @default(now())
 creator User? @relation("BattleCreator", fields:[creatorId], references:[id], onDelete:SetNull)
 challenger User? @relation("BattleChallenger", fields:[challengerId], references:[id], onDelete:SetNull)
 opponent User? @relation("BattleOpponent", fields:[opponentId], references:[id], onDelete:SetNull)
 winner User? @relation("BattleWinner", fields:[winnerId], references:[id], onDelete:SetNull)
 challengerPost Post? @relation("BattleChallengerPost", fields:[challengerPostId], references:[id], onDelete:SetNull)
 opponentPost Post? @relation("BattleOpponentPost", fields:[opponentPostId], references:[id], onDelete:SetNull)
 votes BattleVote[]
 @@index([status,endsAt])
 @@schema("social_gaming")
}

model BattleVote {
 id String @id @default(cuid())
 battleId String
 userId String
 choice String
 createdAt DateTime @default(now())
 battle Battle @relation(fields:[battleId], references:[id], onDelete:Cascade)
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@unique([battleId,userId])
 @@schema("social_gaming")
}

model Referral {
 id String @id @default(cuid())
 referrerId String
 referredId String @unique
 createdAt DateTime @default(now())
 referrer User @relation("ReferralReferrer", fields:[referrerId], references:[id], onDelete:Cascade)
 referred User @relation("ReferralReferred", fields:[referredId], references:[id], onDelete:Cascade)
 @@index([referrerId,createdAt])
 @@schema("social_gaming")
}

model AdminAction {
 id String @id @default(cuid())
 actorId String
 action String
 targetType String
 targetId String
 details String @default("")
 createdAt DateTime @default(now())
 actor User @relation("AdminActor", fields:[actorId], references:[id], onDelete:Restrict)
 @@index([createdAt])
 @@index([targetType,targetId])
 @@schema("social_gaming")
}

model ReferralShareClaim {
 id String @id @default(cuid())
 userId String
 periodKey String
 createdAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@unique([userId,periodKey])
 @@schema("social_gaming")
}

model DailyMission {
 id String @id @default(cuid())
 key String @unique
 title String
 description String
 actionType String
 target Int @default(1)
 reward Int @default(100)
 rewardType String @default("POINTS")
 active Boolean @default(true)
 createdAt DateTime @default(now())
 progress MissionProgress[]
 @@schema("social_gaming")
}

model MissionProgress {
 id String @id @default(cuid())
 userId String
 missionId String
 periodKey String
 progress Int @default(0)
 completed Boolean @default(false)
 claimed Boolean @default(false)
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 mission DailyMission @relation(fields:[missionId], references:[id], onDelete:Cascade)
 @@unique([userId,missionId,periodKey])
 @@index([userId,periodKey])
 @@schema("social_gaming")
}

model GameSession {
 id String @id @default(cuid())
 userId String
 startedAt DateTime @default(now())
 endsAt DateTime
 claimedAt DateTime?
 score Int?
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@index([userId,startedAt])
 @@schema("social_gaming")
}

model Achievement {
 id String @id @default(cuid())
 key String @unique
 title String
 description String
 metric String
 target Int
 active Boolean @default(true)
 users UserAchievement[]
 @@schema("social_gaming")
}

model UserAchievement {
 id String @id @default(cuid())
 userId String
 achievementId String
 unlockedAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 achievement Achievement @relation(fields:[achievementId], references:[id], onDelete:Cascade)
 @@unique([userId,achievementId])
 @@schema("social_gaming")
}

model Team {
 id String @id @default(cuid())
 name String @unique
 description String @default("")
 creatorId String
 createdAt DateTime @default(now())
 creator User @relation("TeamCreator", fields:[creatorId], references:[id], onDelete:Cascade)
 members TeamMember[]
 @@schema("social_gaming")
}

model TeamMember {
 id String @id @default(cuid())
 teamId String
 userId String
 joinedAt DateTime @default(now())
 team Team @relation(fields:[teamId], references:[id], onDelete:Cascade)
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@unique([teamId,userId])
 @@index([userId])
 @@schema("social_gaming")
}

model MysteryRewardClaim {
 id String @id @default(cuid())
 userId String
 periodKey String
 rewardType String
 amount Int @default(0)
 createdAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@unique([userId,periodKey])
 @@schema("social_gaming")
}
