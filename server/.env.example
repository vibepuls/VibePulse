# Copy to server/.env and replace every placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
AUTH_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
PORT=4000

# Optional Supabase Storage uploads (API/server only; never expose service-role key in the browser).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=vibepulse-media


# Private Bengali-only Voice Studio access. Configure real values in Render, not in Git.
VOICE_STUDIO_ACCESS_PASSWORD=choose-a-private-password

# Voice Studio inference service (server-side only; never put tokens in VITE_* variables).
# The endpoint must accept multipart fields: sample, text, language, user_id
# and return raw audio bytes with an audio/* Content-Type.
VOICE_ENGINE_URL=
VOICE_ENGINE_TOKEN=
